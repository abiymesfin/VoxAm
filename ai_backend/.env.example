# REQUIRED: set this privately in Render Environment settings, never in frontend code/GitHub.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# For a public deployment, do not allow requests without an access token.
ALLOW_NO_ACCESS_CODE=false
APP_ACCESS_TOKEN=SET_A_LONG_RANDOM_SECRET_HERE

# Set the exact Netlify site origin(s), comma-separated. Do not use * in production.
CORS_ORIGINS=https://your-site.netlify.app
LOG_LEVEL=INFO
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=300
MAX_DUB_SEGMENTS=36
FFMPEG_TIMEOUT_SECONDS=180

# Current Gemini API model identifiers verified against the official documentation.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
